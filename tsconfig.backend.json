{
  "extends": ["@tsconfig/recommended/tsconfig.json", "@tsconfig/node18/tsconfig.json"],
  "compilerOptions": {
    "noEmit": true,
    "sourceMap": true,
    "verbatimModuleSyntax": true,
    "moduleResolution": "bundler",
    "module": "ES2022"
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["dist/", "src/ui/"]
}
