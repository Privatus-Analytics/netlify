{
  "name": "privatus-analytics-netlify-extension",
  "version": "1.0.0",
  "description": "Privatus Analytics for Netlify: adds the Privatus Analytics tracking script to a project's HTML at build time.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "node": ">=20.12.2"
  },
  "scripts": {
    "build": "netlify-extension build",
    "dev": "netlify-extension dev",
    "dev:open": "netlify-extension dev --open",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.backend.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@netlify/functions": "6.0.2",
    "@netlify/sdk": "5.0.4",
    "@tanstack/react-query": "5.104.1",
    "@trpc/client": "11.19.0",
    "@trpc/react-query": "11.19.0",
    "@trpc/server": "11.19.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@netlify/build": "35.15.0",
    "@netlify/netlify-plugin-netlify-extension": "1.2.2",
    "@tsconfig/node18": "18.2.7",
    "@tsconfig/recommended": "1.0.13",
    "@tsconfig/vite-react": "8.1.1",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.1",
    "netlify-cli": "23.15.1",
    "postcss": "8.5.29",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "3.2.7"
  }
}
